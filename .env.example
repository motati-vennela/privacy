# Database URLs
SOURCE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/source_db
PROTECTED_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/protected_db
VAULT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vault_db

# Encryption keys (DO NOT commit to Git)
FPE_KEY=0123456789abcdef0123456789abcdef
VAULT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TOKEN_SECRET=super-secret-token-key-change-in-production

# Application
APP_NAME=Privacy-Preserving CDP
APP_PORT=8000
DEBUG=true

# Email (for testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# Auth
JWT_SECRET=jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
